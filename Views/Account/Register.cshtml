@{
    ViewData["Title"] = "Register";
}

<style>
    .theme-card {
        border: none;
        border-radius: 1rem;
        background-color: #ffffff;
        box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.15);
    }

    .theme-title {
        color: #2c3e50;
        font-family: 'Montserrat', sans-serif;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .divider-custom {
        margin: 1rem 0 1.5rem;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .divider-custom-line {
        width: 100%;
        max-width: 4rem;
        height: 0.25rem;
        background-color: #2c3e50;
        border-radius: 1rem;
    }

    .divider-custom-icon {
        color: #2c3e50;
        font-size: 1.25rem;
        margin: 0 1rem;
    }

    .theme-input {
        border-radius: 0.5rem;
        border: 2px solid #ced4da;
        padding: 0.75rem 1rem;
        transition: all 0.3s ease;
    }

        .theme-input:focus {
            border-color: #1abc9c;
            box-shadow: 0 0 0 0.25rem rgba(26, 188, 156, 0.25);
        }

    .theme-label {
        color: #2c3e50;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .btn-theme {
        background-color: #1abc9c;
        border: 2px solid #1abc9c;
        color: white;
        font-weight: 700;
        text-transform: uppercase;
        padding: 0.75rem 1.5rem;
        border-radius: 0.5rem;
        transition: all 0.3s ease;
    }

        .btn-theme:hover {
            background-color: #159b80;
            border-color: #159b80;
            color: white;
        }

    .text-theme-link {
        color: #1abc9c;
        font-weight: bold;
    }

        .text-theme-link:hover {
            color: #159b80;
        }
</style>

<div class="container min-vh-100 d-flex flex-column justify-content-center py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card theme-card p-4">
                <div class="card-body">
                    <h2 class="text-center theme-title mb-0">Register</h2>
                    <div class="divider-custom">
                        <div class="divider-custom-line"></div>
                        <div class="divider-custom-icon">★</div>
                        <div class="divider-custom-line"></div>
                    </div>

                    <form asp-controller="Account" asp-action="Register" method="post" id="registerForm">

                        <div class="mb-3">
                            <label class="form-label theme-label">Full Name</label>
                            <input type="text" id="fullNameInput" name="FullName" class="form-control theme-input" placeholder="Enter your full name" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label theme-label">Email Address</label>
                            <input type="email" id="emailInput" name="Email" class="form-control theme-input" placeholder="example@domain.com" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label theme-label">Password</label>
                            <input type="password" id="passwordInput" name="Password" class="form-control theme-input" placeholder="Create a password" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label theme-label">Confirm Password</label>
                            <input type="password" id="confirmPasswordInput" name="ConfirmPassword" class="form-control theme-input" placeholder="Confirm your password" required />
                        </div>

                        <!-- Action Buttons -->
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-theme w-100 mb-2">Sign Up</button>
                            <button type="button" class="btn btn-secondary w-100 mb-2" id="viewBtn">View List</button>
                            <button type="button" class="btn btn-warning w-100 mb-2" id="updateBtn">Update</button>
                            <button type="button" class="btn btn-danger w-100" id="deleteBtn">Delete</button>
                        </div>
                    </form>

                    <div class="text-center mt-4">
                        <p class="text-muted">
                            Already have an account?
                            <a asp-controller="Account" asp-action="Login" class="text-theme-link text-decoration-none">Sign In</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {

            // Register Form Submit (Displays only the Insert query upon success)
            $("#registerForm").submit(function (e) {
                e.preventDefault();

                let fullName = $("#fullNameInput").val();
                let email = $("#emailInput").val();
                let password = $("#passwordInput").val();
                let confirmPassword = $("#confirmPasswordInput").val();

                if (fullName == "" || email == "" || password == "" || confirmPassword == "") {
                    alert("Please complete all fields.");
                    return;
                }

                if (password !== confirmPassword) {
                    alert("Passwords do not match!");
                    return;
                }

                let confirmMessage =
                    "Please confirm your registration:\n\n" +
                    "Full Name: " + fullName + "\n" +
                    "Email: " + email +
                    "\n\nContinue?";

                if (confirm(confirmMessage)) {
                    let registerData = {
                        FullName: fullName,
                        Email: email,
                        Password: password,
                        ConfirmPassword: confirmPassword
                    };

                    $.ajax({
                        url: '@Url.Action("Register", "Account")',
                        type: "POST",
                        contentType: "application/json",
                        data: JSON.stringify(registerData),
                        success: function (response) {
                            if (response.success) {
                                // Displays ONLY the insert query
                                alert("Generated Insert Query:\n\n" + response.insertQuery);
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function (xhr) {
                            console.log(xhr.responseText);
                            alert("AJAX request failed.");
                        }
                    });
                } else {
                    alert("Registration cancelled.");
                }
            });

            // View List Button
            $("#viewBtn").click(function () {
                $.ajax({
                    url: '@Url.Action("ViewList", "Account")',
                    type: "GET",
                    success: function (response) {
                        alert("Select Query Generated (View List):\n\n" + response.message);
                    },
                    error: function () {
                        alert("Request failed.");
                    }
                });
            });

            // Update Button
            $("#updateBtn").click(function () {
                let updateData = {
                    FullName: $("#fullNameInput").val(),
                    Email: $("#emailInput").val(),
                    Password: $("#passwordInput").val(),
                    ConfirmPassword: $("#confirmPasswordInput").val()
                };

                $.ajax({
                    url: '@Url.Action("Update", "Account")',
                    type: "POST",
                    contentType: "application/json",
                    data: JSON.stringify(updateData),
                    success: function (response) {
                        if (response.success) {
                            alert("Update Query Generated:\n\n" + response.message);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert("Update request failed.");
                    }
                });
            });

            // Delete Button
            $("#deleteBtn").click(function () {
                if (confirm("Are you sure you want to generate a delete query for this record?")) {
                    $.ajax({
                        url: '@Url.Action("Delete", "Account")',
                        type: "POST",
                        success: function (response) {
                            if (response.success) {
                                alert("Delete Query Generated:\n\n" + response.message);
                            } else {
                                alert(response.message);
                            }
                        },
                        error: function () {
                            alert("Delete request failed.");
                        }
                    });
                }
            });

        });
    </script>
}
}
